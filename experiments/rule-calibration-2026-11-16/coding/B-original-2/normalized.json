          "function_id": "instruct",
          "decision": "unresolved",
          "status": "ambiguous",
          "anchors": [
            {
              "unit_id": "LF-03f718ef8cc6-p021",
              "quote": "To get a hang glider airborne, you stand about 40 feet from the edge of a cliff and run off of it at full speed.",
              "occurrence": 0,
              "start": 709,
              "end": 821,
              "text_sha256": "8ee658379764a341c38ec02a5dd69c583683e689a3efadf9704e0f1e88574d2b",
              "source_id": "LF-03f718ef8cc6",
              "unit_sha256": "744761d5ace0585020e66e61692caa724b16125ce29ec34318322a7b43159c80"
